{
  "seatbelty-pre-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/pre_tool_guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "view_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/pre_tool_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "seatbelty-post-mask": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/post_tool_mask.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "view_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/post_tool_mask.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}